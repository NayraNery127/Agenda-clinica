generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Appointment {
  id           String   @id @default(uuid())
  patientName  String
  date         String   // formato YYYY-MM-DD (mantido como string para evitar problemas de fuso horário)
  time         String   // formato HH:mm (ex: "09:00")
  createdAt    DateTime @default(now())

  @@unique([date, time]) // impede dois agendamentos no mesmo horário
}
